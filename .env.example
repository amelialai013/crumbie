# Public URL; crumbie.com.au is unconfirmed and must not be connected without approval.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use a brand-new Redis-compatible database. Never reuse Imperfect Bakers values.
KV_REST_API_URL=https://placeholder-redis.example
KV_REST_API_TOKEN=replace-with-new-token
# Stripe Projects Upstash can be used instead of the KV_REST_API_* pair.
UPSTASH_REST_URL=https://placeholder-upstash.example
UPSTASH_REST_TOKEN=replace-with-new-token

# Generate unique values for Crumbie. Do not commit real values.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Separate Crumbie Stripe account/configuration; test keys only during development.
# Prefer a restricted rk_test_ key with only the permissions this storefront needs.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Enable only after Stripe Tax settings are active and the relevant registration is Collecting.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Confirm the baked-goods code in Stripe's Tax Code list; do not guess this value.
STRIPE_PRODUCT_TAX_CODE=txcd_replace_me
# Confirm whether catalogue prices include or exclude tax before enabling Stripe Tax.
STRIPE_TAX_BEHAVIOR=inclusive

# Separate Crumbie R2 bucket and credentials.
R2_ENDPOINT=https://placeholder.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=crumbie-media-placeholder
R2_PUBLIC_URL=https://media.crumbie.example

# Separate Crumbie Resend identity. hello@crumbie.example is a placeholder.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Crumbie <hello@crumbie.example>
CRUMBIE_NOTIFICATION_EMAIL=hello@crumbie.example
