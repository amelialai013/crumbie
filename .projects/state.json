{
  "version": 1,
  "providers": {
    "resend": {
      "name": "Resend"
    },
    "upstash": {
      "name": "Upstash"
    }
  },
  "resources": {
    "resend-email": {
      "name": "resend-email",
      "providerName": "Resend",
      "serviceId": "email"
    },
    "resend-plan": {
      "name": "resend-plan",
      "providerName": "Resend",
      "serviceId": "free"
    },
    "store": {
      "name": "store",
      "providerName": "Upstash",
      "serviceId": "redis"
    }
  },
  "environments": {
    "default": {
      "output": ".env",
      "resources": [
        {
          "resourceName": "resend-email"
        },
        {
          "resourceName": "resend-plan"
        },
        {
          "resourceName": "store"
        }
      ],
      "variables": [
        {
          "variableName": "admin-password",
          "envKey": "ADMIN_PASSWORD"
        },
        {
          "variableName": "admin-session-secret",
          "envKey": "ADMIN_SESSION_SECRET"
        },
        {
          "variableName": "notification-email",
          "envKey": "CRUMBIE_NOTIFICATION_EMAIL"
        }
      ]
    }
  },
  "variables": {
    "admin-password": {
      "name": "admin-password",
